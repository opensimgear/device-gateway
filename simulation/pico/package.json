{
  "name": "@opensimgear/pico-simulation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node firmware/build.mjs",
    "test": "node firmware/test.mjs && node --test pico-bridge.test.mjs pico-integration.test.mjs pico-hid-names.test.mjs pico-hid-names-helper.test.mjs",
    "ui:fixture": "node pico-ui-fixture.mjs",
    "verify": "mkdir -p ../../.simulation/pico/module-cache && xcrun swiftc -module-cache-path ../../.simulation/pico/module-cache verify-hid.swift -o ../../.simulation/pico/verify-hid && ../../.simulation/pico/verify-hid"
  },
  "dependencies": {
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "svelte": "^5.55.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1"
  },
  "packageManager": "pnpm@11.25.0"
}
